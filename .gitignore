# Secrets. The MTS API key lives only here and never in git.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local data and logs
*.log
logs/
data/
feeds/

# Frontend
node_modules/
web/dist/
web/.vite/

# Browser automation output
.playwright-mcp/

# macOS
.DS_Store

# Terraform. State holds resource attributes and must never be committed; the
# tfvars file holds the SSH key and the operator's address.
infra/.terraform/
infra/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
tfplan
