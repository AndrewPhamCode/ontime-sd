# Copy to .env and fill in. .env is gitignored and must never be committed.

# Postgres from docker-compose. Port 5433 avoids the Homebrew postgresql@16
# instance already listening on 5432.
DATABASE_URL=postgresql://ontime:ontime@localhost:5433/ontime_sd

# MTS realtime feed. Leave MTS_API_KEY blank to run against the mock server.
# When the real key arrives, set it and switch MTS_FEED_BASE_URL to the real host.
MTS_API_KEY=
MTS_FEED_BASE_URL=http://localhost:8081/api/api/gtfs_realtime
# Real value:
# MTS_FEED_BASE_URL=https://realtime.sdmts.com/api/api/gtfs_realtime

# Static GTFS schedule. Public, no key required.
GTFS_STATIC_URL=https://www.sdmts.com/google_transit_files/google_transit.zip

# Collector behavior
POLL_INTERVAL_SECONDS=30
PREDICTION_CHANGE_THRESHOLD_SECONDS=30
BACKOFF_BASE_SECONDS=1
BACKOFF_MAX_SECONDS=300
HEALTH_PORT=8080
HEALTH_STALE_AFTER_SECONDS=300
LOG_LEVEL=INFO

# Mock feed server
MOCK_PORT=8081
MOCK_VEHICLE_COUNT=40

# How often the mock advances its feed header timestamp. Set this above
# POLL_INTERVAL_SECONDS to exercise the unchanged-header skip path.
MOCK_FEED_REFRESH_SECONDS=30

# per_stop or single_delay. CLAUDE.md records the OneBusAway trip update shape
# as unverified, so the mock can emit either one.
MOCK_TRIP_UPDATE_STYLE=per_stop

# Failure injection, for testing backoff and error handling. All default to
# off. Tests force specific failures with query parameters instead, so they do
# not depend on randomness.
MOCK_FAILURE_RATE=0.0
MOCK_SLOW_RATE=0.0
MOCK_SLOW_SECONDS=5.0
MOCK_TRUNCATE_RATE=0.0
