<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>sd.ontime.collector</string>

  <!-- launchd provides no PATH, so every path here is absolute.

       Wrapped in caffeinate so the collector holds a sleep assertion for its
       entire life, rather than depending on someone remembering to run
       caffeinate by hand. Measured cost of not doing this: collection coverage
       fell to 35%, losing about 15 hours of irreplaceable data per day. See
       ADR-0015.

         -i  prevent idle system sleep, which applies on battery too
         -s  prevent system sleep, which the OS honours only on AC power

       Display sleep is deliberately NOT prevented: the screen can turn off,
       which saves power and is irrelevant to collection. Closing the lid still
       sleeps the machine, which no user space assertion can override. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-si</string>
    <string>__UV__</string>
    <string>run</string>
    <string>--project</string>
    <string>__PROJECT_DIR__</string>
    <string>ontime-collector</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <!-- Start at login and restart on exit, so the collector keeps running
       without supervision. ThrottleInterval bounds a crash loop: if the
       database is unreachable the process exits and is restarted, and this
       keeps that from becoming a busy loop. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <!-- JSON logs, one object per line, readable with jq. -->
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/collector.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/collector.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
</dict>
</plist>
